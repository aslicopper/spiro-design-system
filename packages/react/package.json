{
  "name": "@aslicopper/react",
  "version": "0.16.0",
  "description": "Spiro Design System — accessible, themeable React components.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "@aslicopper/tokens": "^0.16.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist && cat src/Button/Button.css > dist/styles.css",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aslicopper/Spiro_.git",
    "directory": "packages/react"
  },
  "keywords": ["design-system", "react", "spiro", "components"],
  "license": "UNLICENSED",
  "sideEffects": ["./dist/styles.css", "*.css"]
}
